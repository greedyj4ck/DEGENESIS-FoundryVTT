<ol id="combat-tracker" class="combat-tracker plain">
	{{#each turns}}

    <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
		<img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

		<div class="token-name flexcol">
			<h4>{{name}} </h4>
			<div class="combatant-controls flexrow">
				{{#if @root.user.isGM}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                        data-action="toggleHidden" data-tooltip aria-label="{{ localize "COMBAT.ToggleVis" }}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                        data-action="toggleDefeated" data-tooltip
                        aria-label="{{ localize "COMBAT.ToggleDead" }}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-person-walking motion-toggle {{#if actor.system.state.motion}}active{{/if}}"
                        data-tooltip aria-label="{{ localize "DGNS.InMotion" }}"></button>
				{{/if}}
				{{#if canPing}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                        data-action="pingCombatant" data-tooltip
                        aria-label="{{ localize "COMBAT.PingCombatant" }}"></button>
				{{/if}}
				{{#unless @root.user.isGM}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-arrows-to-eye"
                        data-action="panToCombatant" data-tooltip
                        aria-label="{{ localize "COMBAT.PanToCombatant" }}"></button>
				{{/unless}}
                {{!-- TODO: Target Control --}}
                <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
                    {{#each effects.icons}}
                    <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                    {{/each}}
                </div>
			</div>
		</div>

        {{#if resource includeZero=true}}
        <div class="token-resource">
            <span class="resource">{{ resource }}</span>
        </div>
        {{/if}}

		<div class="token-actions">
			{{#if initiative includeZero=true}}
				<div class="initiative-number" data-tooltip="DGNS.Initiative">
					{{initiative}}
				</div>

				<div class="token-actions-control">
					<div class="actions-number">{{actor.system.state.initiative.actions}}</div>
					<a class="action action-add btn " data-tooltip="UI.AddAction" data-action="actionClick" data-op="add">+</a>
					<a class="action action-remove btn" data-tooltip="UI.RemoveAction" data-action="actionClick" data-op="remove">-</a>
				</div>
				<div class="actions-label">{{localize 'DGNS.Actions'}}</div>
			{{else if isOwner}}
				<div class="roll-initiative">
					<div class="initiative-die">
						<button type="button" class="combatant-control roll" data-action="rollInitiative" data-tooltip
							aria-label="{{ localize "COMBAT.InitiativeRoll" }}"
							style="--initiative-icon: url('{{ @root.initiativeIcon.icon }}'); --initiative-icon-hover: url('{{ @root.initiativeIcon.hover }}');">
						</button>
					</div>

					{{#if actor.isPrimalPhase}}
						<div class="diamond-row" data-target="system.state.spentSpore.value" data-tooltip="DGNS.SpendSpore">
							{{#each actor.system.state.spentSpore.diamonds as |diamond index|}} {{#if
							diamond.filled}}
							<a class="diamond" data-index="{{index}}" data-action="diamondClick">
								<div class="square gold"></div>
							</a>
							{{else}}
							<a class="diamond" data-index="{{index}}" data-action="diamondClick">
								<div class="square"></div>
							</a>
							{{/if}} {{/each}}
						</div>

					{{else}}
						<div class="diamond-row" data-target="system.state.spentEgo.value" data-tooltip="DGNS.SpendEgo">
							{{#each actor.system.state.spentEgo.diamonds as |diamond index|}}
								{{#if diamond.filled}}
									<a class="diamond" data-index="{{index}}" data-action="diamondClick">
										<div class="square gold"></div>
									</a>
								{{else}}
									<a class="diamond" data-index="{{index}}" data-action="diamondClick">
										<div class="square"></div>
									</a>
								{{/if}}
							{{/each}}
						</div>
					{{/if}}
				</div>
			{{/if}}
		</div>
	</li>
	{{/each}}
</ol>